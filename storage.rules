rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors firestore.rules' isSuperAdmin(). Both rule files have to agree:
    // a super admin whose Firestore write is allowed but whose photo upload is
    // denied leaves a profile saved with its media missing — that exact bug has
    // been shipped here before, so these two files change together or not at all.
    function isSuperAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/super_admins/$(request.auth.uid));
    }

    // Mirrors firestore.rules' ownsTenant() — access is a document, not a field.
    // admins/{t}/staff/{uid} grants that one site; super_admins grants all.
    function ownsTenant(t) {
      return isSuperAdmin()
        || (isSignedIn()
            && firestore.exists(/databases/(default)/documents/admins/$(t)/staff/$(request.auth.uid)));
    }

    // ══ MIGRATION — mirrors legacyOwnsTenant() in firestore.rules ════════════
    // Honours the pre-split /admins record so a session on the old login code
    // can still upload. REMOVE together with its counterpart in firestore.rules.
    function legacyOwnsTenant(t) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.tenant_id == t;
    }
    // ══ END MIGRATION ════════════════════════════════════════════════════════

    // Any file under a tenant folder is public to fetch: the kiosk is
    // unauthenticated, same as the memorial records in Firestore. Writes are
    // split by what the path is FOR, because overlapping match blocks are
    // OR-ed — one broad "staff may write anything here" rule would let staff
    // replace the site's look too.
    //
    //   {tenantId}/background.{ext}              site background   — super admin
    //   {tenantId}/backgrounds/background{n}.{ext} memorial presets — super admin
    //   {tenantId}/{personId}/{file}             memorial media    — site staff
    //
    // Both are edited from the admin's 施設設定 tab (super admins only), which
    // mirrors who may change tenants/{tid} in firestore.rules.
    //
    // Reads are split: fetching one file by path stays public, LISTING a
    // folder is staff only. Memorial media sits in folders named by person
    // id, so listing a tenant folder hands out the id of every person at the
    // site — the same enumeration firestore.rules closes on families. Neither
    // app lists Storage; everything goes through getDownloadURL(), a get.
    match /{tenantId}/{file} {
      allow get:  if true;
      allow list: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
      allow write: if tenantId != 'individuals_backgrounds' && isSuperAdmin();
    }
    match /{tenantId}/backgrounds/{file} {
      allow get:  if true;
      allow list: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
      allow write: if isSuperAdmin();
    }
    match /{tenantId}/{personId}/{file} {
      allow get:  if true;
      allow list: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
      allow write: if personId != 'backgrounds'
                   && (ownsTenant(tenantId) || legacyOwnsTenant(tenantId));
    }

    // Shared fallback backgrounds — public read, no client writes (console-managed).
    match /individuals_backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny anything unmatched.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
