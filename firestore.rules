rules_version = '2';

// SmartSenior — multi-tenant memorial kiosk.
//
// Tenant isolation model:
//   • Memorial content lives under its tenant — tenants/{tid}/individuals/{id},
//     tenants/{tid}/families/{id} — so the PATH decides which site a record
//     belongs to.
//   • Access is a DOCUMENT, not a field. admins/{tid}/staff/{uid} grants that
//     one site; super_admins/{uid} grants all of them. Both are checked with
//     exists() on a fully-specified path, live on every write, so revoking
//     someone takes effect immediately and a tampered client can claim neither.
//   • Memorial content is publicly READABLE because the visitor-facing kiosk
//     runs without authentication. Each kiosk is pinned to one tenant by the
//     path it reads, but reads themselves are open — except listing a site's
//     families, which would enumerate every person id (see /families).
//
// A super admin belongs to NO tenant. The `default_tenant` on their record only
// decides which site the admin panel opens on; it grants nothing.
//
// MIGRATION IN PROGRESS: the pre-split flat /admins collection is still present
// and still honoured. See the MIGRATION block below for what has to be true
// before it can be deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // SmartSenior staff who administer every memorial site. Membership in
    // /super_admins IS the grant — there is no role field to disagree with a
    // tenant field, because a super admin belongs to no tenant at all.
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // True when the signed-in user may write to tenant `t`.
    //
    // The grant is a document at admins/$(t)/staff/$(uid): a fully-specified
    // path, so this is exists() rather than reading a record and comparing a
    // field. Checked live on every write, so revoking someone still takes
    // effect immediately and a tampered client cannot claim either status.
    function ownsTenant(t) {
      return isSuperAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/admins/$(t)/staff/$(request.auth.uid)));
    }

    // ══ MIGRATION — the pre-split flat admins collection ═════════════════════
    // Still present and still honoured, so a session running the old login code
    // (which reads admins/{uid}.tenant_id) keeps working while the switchover
    // lands. scripts/split-admins.js has already written every one of these as a
    // membership document; `--verify` proves the two agree.
    //
    // REMOVE this function, its two uses in ownsTenant call sites, and the
    // /admins/{uid} block, once the admin panel is deployed on the new login
    // path and real sign-ins have been observed. Then delete the collection.
    function legacyOwnsTenant(t) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.tenant_id == t;
    }

    // ══ END MIGRATION ════════════════════════════════════════════════════════

    // ── Staff accounts ──────────────────────────────────────────────────────
    // Managed by super admins from the admin panel's Staff tab (and still by
    // hand in the console). A tenant staff member can never grant anyone
    // access, themselves included: only /super_admins membership may write
    // here, and that membership itself is only writable by another super
    // admin. A user may read their OWN membership document — that is how
    // login discovers which tenant to open — but not anyone else's, so the
    // staff list of a site is not readable by its visitors.
    //
    //   admins/{tenantId}/staff/{uid}  grants that one site
    //   super_admins/{uid}             grants every site
    //
    // A membership document carries a display_name and (for records made from
    // the panel) the email it was created for, so the Staff tab can show who a
    // UID is. Login reads only display_name / default_tenant; the rest is
    // informational and never consulted for access.
    //
    // The {docId} on /admins matches two different things during the migration:
    // the tenant containers, and the pre-split records still keyed by UID. The
    // read rule below covers the legacy case (docId == your own uid); the
    // containers themselves hold nothing worth reading.
    function validStaffRecord() {
      return request.resource.data.keys().hasOnly(
               ['display_name', 'email', 'default_tenant', 'created_at', 'created_by', 'updated_at'])
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 120;
    }

    match /admins/{docId} {
      allow read:  if isSignedIn() && request.auth.uid == docId;
      allow write: if false;

      match /staff/{uid} {
        allow read:   if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if isSuperAdmin() && validStaffRecord();
        allow delete: if isSuperAdmin();
      }
    }

    match /super_admins/{uid} {
      allow read:   if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSuperAdmin() && validStaffRecord();
      // A super admin cannot remove their own grant: the last one standing
      // would otherwise be able to lock everyone out of staff management.
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }

    // ── Tenant configuration + all memorial content ─────────────────────────
    // Memorial records live UNDER their tenant: tenants/{tid}/individuals/{id}.
    //
    // The path segment is what grants the write, not a field in the document
    // body — so a record cannot be written into a tenant the caller doesn't
    // own no matter what its `tenant_id` says. The pre-nesting rules compared
    // request.resource.data.tenant_id on create and resource.data on update,
    // which meant a bug that stamped the wrong tenant_id could file a record at
    // the wrong memorial site and the rules would allow it. Nesting makes that
    // class of bug unrepresentable, which is why create/update/delete collapse
    // back into a single `write` here.
    match /tenants/{tenantId} {
      allow read:  if true;   // kiosk reads accent_color, bgm_path, name
      // A tenant is still created and renamed in the console. Its kiosk look —
      // accent colour, font, welcome text, feature switches — is edited by a
      // super admin on the 施設設定 tab, and only those keys may change.
      allow create, delete: if false;
      allow update: if isSuperAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['accent_color', 'font_family', 'strings', 'features', 'updated_at']);

      match /individuals/{personId} {
        allow read:  if true;                    // public kiosk
        allow write: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);

        match /media/{mediaId} {
          allow read:  if true;                  // public kiosk
          allow write: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
        }
      }

      // A family holds at most 8 members: the kiosk family page fits two rows
      // and narrows the cards past that until names split mid-word. The admin
      // panel refuses the 9th member before it gets here; this is the backstop
      // for two admins adding at once, or a stale tab. Delete stays separate
      // because request.resource does not exist on a delete.
      function withinFamilyLimit() {
        return !('member_ids' in request.resource.data)
          || request.resource.data.member_ids.size() <= 8;
      }

      match /families/{familyId} {
        // One family by id stays public. LISTING a site's families is staff
        // only: every family carries member_ids, so an open list hands out the
        // id of every person at the site — and a person by id is public (QR
        // codes depend on it). The kiosk never reads families at all; the admin
        // family pages list them as staff.
        allow get:    if true;
        allow list:   if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
        allow create, update: if (ownsTenant(tenantId) || legacyOwnsTenant(tenantId))
                              && withinFamilyLimit();
        allow delete: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);

        // Family contact (施主・ご遺族の連絡先), one per family: a relative's
        // name, address, phone and email. Kept in a PRIVATE subdocument
        // because the family itself is readable by the unauthenticated
        // kiosk. Site staff only.
        match /private/{docId} {
          allow read, write: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
        }
      }

      // ── Memorial access log ─────────────────────────────────────────────
      // One record per memorial page view, written anonymously by the kiosk
      // (kiosk/js/access-log.js) and read by staff on the 利用状況 tab. Each
      // carries a `visit` id (one use of the kiosk) so the tab counts
      // visitors, not page views. Append-only: nothing is ever edited or
      // removed, and the open create accepts only these fields at these
      // sizes — with `ts` pinned to the server clock — so it cannot be used
      // to store anything else.
      match /access_logs/{logId} {
        allow read: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
        allow create: if request.resource.data.keys().hasOnly(
                          ['person_id', 'name', 'page', 'entry', 'visit', 'dev', 'ts', 'at', 'date', 'ym', 'h', 'w'])
                      && request.resource.data.person_id is string
                      && request.resource.data.person_id.size() <= 64
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 100
                      && request.resource.data.page in ['profile', 'family', 'slideshow']
                      && request.resource.data.entry in ['search', 'link']
                      && request.resource.data.visit is string
                      && request.resource.data.visit.size() <= 32
                      && request.resource.data.dev is string
                      && request.resource.data.dev.size() <= 32
                      && request.resource.data.at is string
                      && request.resource.data.at.size() <= 40
                      && request.resource.data.date is string
                      && request.resource.data.date.size() == 10
                      && request.resource.data.ym is string
                      && request.resource.data.ym.size() == 7
                      && request.resource.data.h is int
                      && request.resource.data.w is int
                      && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }

    // ── Kiosk devices ───────────────────────────────────────────────────────
    match /kiosk_devices/{id} {
      allow read:  if true;
      allow write: if false;
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
 