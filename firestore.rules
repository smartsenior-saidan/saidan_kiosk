rules_version = '2';

// SmartSenior — multi-tenant memorial kiosk.
//
// Tenant isolation model:
//   • Memorial content lives under its tenant — tenants/{tid}/individuals/{id},
//     tenants/{tid}/families/{id} — so the PATH decides which site a record
//     belongs to.
//   • Access is a DOCUMENT, not a field. tenants/{tid}/admins/{uid} grants that
//     one site; super_admins/{uid} grants all of them. Both are checked with
//     exists() on a fully-specified path, live on every write, so revoking
//     someone takes effect immediately and a tampered client can claim neither.
//   • Memorial content is publicly READABLE because the visitor-facing kiosk
//     runs without authentication. Each kiosk is pinned to one tenant by the
//     path it reads, but reads themselves are open.
//
// A super admin belongs to NO tenant. The `default_tenant` on their record only
// decides which site the admin panel opens on; it grants nothing.
//
// MIGRATION IN PROGRESS: the pre-split flat /admins collection is still present
// and still honoured. See the MIGRATION block below for what has to be true
// before it can be deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // SmartSenior staff who administer every memorial site. Membership in
    // /super_admins IS the grant — there is no role field to disagree with a
    // tenant field, because a super admin belongs to no tenant at all.
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // True when the signed-in user may write to tenant `t`.
    //
    // The grant is a document at tenants/$(t)/admins/$(uid): a fully-specified
    // path, so this is exists() rather than reading a record and comparing a
    // field. Checked live on every write, so revoking someone still takes
    // effect immediately and a tampered client cannot claim either status.
    function ownsTenant(t) {
      return isSuperAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/tenants/$(t)/admins/$(request.auth.uid)));
    }

    // ══ MIGRATION — the pre-split flat admins collection ═════════════════════
    // Still present and still honoured, so a session running the old login code
    // (which reads admins/{uid}.tenant_id) keeps working while the switchover
    // lands. scripts/split-admins.js has already written every one of these as a
    // membership document; `--verify` proves the two agree.
    //
    // REMOVE this function, its two uses in ownsTenant call sites, and the
    // /admins/{uid} block, once the admin panel is deployed on the new login
    // path and real sign-ins have been observed. Then delete the collection.
    function legacyOwnsTenant(t) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.tenant_id == t;
    }

    match /admins/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // ══ END MIGRATION ════════════════════════════════════════════════════════

    // ── Staff accounts ──────────────────────────────────────────────────────
    // Both are console-managed: an account that could grant itself access is
    // not an access control. A user may read their OWN membership document —
    // that is how login discovers which tenant to open — but not anyone else's,
    // so the staff list of a site is not readable by its visitors.
    match /super_admins/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Tenant configuration + all memorial content ─────────────────────────
    // Memorial records live UNDER their tenant: tenants/{tid}/individuals/{id}.
    //
    // The path segment is what grants the write, not a field in the document
    // body — so a record cannot be written into a tenant the caller doesn't
    // own no matter what its `tenant_id` says. The pre-nesting rules compared
    // request.resource.data.tenant_id on create and resource.data on update,
    // which meant a bug that stamped the wrong tenant_id could file a record at
    // the wrong memorial site and the rules would allow it. Nesting makes that
    // class of bug unrepresentable, which is why create/update/delete collapse
    // back into a single `write` here.
    match /tenants/{tenantId} {
      allow read:  if true;   // kiosk reads accent_color, bgm_path, name
      allow write: if false;  // managed via Firebase console / admin SDK only

      // Per-tenant staff. Existence is the grant; see ownsTenant() above.
      // Readable only by the account it names, so login can find its own
      // membership without exposing who else works at a site.
      match /admins/{uid} {
        allow read:  if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /individuals/{personId} {
        allow read:  if true;                    // public kiosk
        allow write: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);

        match /media/{mediaId} {
          allow read:  if true;                  // public kiosk
          allow write: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
        }
      }

      match /families/{familyId} {
        allow read:  if true;                    // public kiosk
        allow write: if ownsTenant(tenantId) || legacyOwnsTenant(tenantId);
      }
    }

    // ── Kiosk devices ───────────────────────────────────────────────────────
    match /kiosk_devices/{id} {
      allow read:  if true;
      allow write: if false;
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
 