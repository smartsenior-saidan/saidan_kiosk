rules_version = '2';
// Emulator boot only. setup.mjs replaces this with ../../firestore.rules before
// any test runs — the CLI refuses rules paths outside this directory, so the
// real file can't be named in firebase.json here. Deny-all, so a failure to load
// the real rules shows up as failing "allowed" tests rather than false passes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
